# Engram Configuration
# Copy this file to .env and fill in your values

# Required: Path to store the database
ENGRAM_DB_PATH=~/.engram

# Optional: Cloud API keys for enhanced quality
# These are optional - Engram works fully offline without them
# GEMINI_API_KEY=your-gemini-api-key
# COHERE_API_KEY=your-cohere-api-key

# Optional: Model configuration
# COLBERT_MODEL=colbert-ir/colbertv2.0
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Optional: Performance tuning
# MAX_MEMORY_CACHE=1000
# RETRIEVAL_TOP_K=50
# RERANK_TOP_K=10

# Transport Configuration (for remote deployment)
# ENGRAM_TRANSPORT=stdio  # Options: stdio (default), http
# PORT=3000               # HTTP port (Railway provides this automatically)
# ENGRAM_MCP_PORT=3000    # Alternative port setting for MCP HTTP server
